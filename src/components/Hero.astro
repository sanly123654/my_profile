---
import { profile } from '../data/profile';

const initials = profile.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<header class="hero">
  <div class="avatar" aria-hidden="true">{initials}</div>
  <div>
    <h1>{profile.name}</h1>
    <p class="title">{profile.title} · {profile.location}</p>
    <p class="bio">{profile.bio}</p>
    <ul class="links">
      {profile.links.map((link) => (
        <li>
          <a href={link.href} rel="noopener noreferrer">{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .hero {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 4rem 0 2.5rem;
  }
  .avatar {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-size: 1.5rem;
  }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); }
  .title { color: var(--muted); margin: 0.25rem 0 1rem; }
  .bio { margin: 0 0 1.25rem; max-width: 60ch; }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  @media (max-width: 520px) {
    .hero { flex-direction: column; padding-top: 2.5rem; }
  }
</style>
